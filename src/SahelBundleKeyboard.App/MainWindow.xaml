<Window x:Class="SahelBundleKeyboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SahelBundleKeyboard.App.Controls"
        Title="إدخال حزم سهل"
        Width="980" Height="700"
        MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#1B7A43"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="WarnButton">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="NeutralButton">
            <Setter Property="Background" Value="#E4E9EF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#D6DEE8"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#123B63" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="إدخال حزم سهل" Foreground="White" FontWeight="Bold" FontSize="18"
                           VerticalAlignment="Center" DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="الحالة:" Foreground="#B9C7D6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="{Binding StateBadgeBrush}" CornerRadius="10" Padding="10,3">
                        <TextBlock Text="{Binding StateText}" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#DDE7F2" VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent">

            <!-- ================= التشغيل ================= -->
            <TabItem Header="التشغيل">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Right column: selection + summary -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <GroupBox Header="اختيار الحزمة">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding Bundles}"
                                          SelectedItem="{Binding SelectedBundle}"
                                          DisplayMemberPath="Name"
                                          Height="32" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="عدد الحزم:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding BundleCountText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="90" Height="30" FontSize="15" TextAlignment="Center"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="(عدد صحيح موجب)" Foreground="#7A8699" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="ملخص الإدخال">
                            <StackPanel>
                                <TextBlock Text="{Binding ItemCountSummary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SummaryDetails}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="#445266" FontSize="12.5"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="وحدة التحكم العائمة">
                            <StackPanel>
                                <Button Content="{Binding ToggleControllerLabel}" Style="{StaticResource NeutralButton}"
                                        Command="{Binding ToggleControllerCommand}"/>
                                <TextBlock Text="الزر العائم لا يسرق التركيز من البرنامج النشط، ويمكن بدء الإدخال به مباشرة."
                                           Foreground="#7A8699" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- Left column: run controls -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <GroupBox Header="التحكم في التشغيل">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="ابدأ" Command="{Binding StartCommand}"
                                            Style="{StaticResource PrimaryButton}" MinWidth="110"/>
                                    <Button Content="إيقاف نهائي" Command="{Binding StopCommand}"
                                            Style="{StaticResource WarnButton}" MinWidth="100" Margin="8,0,0,0"/>
                                </StackPanel>

                                <ProgressBar Value="{Binding ProgressFraction, Mode=OneWay}" Maximum="1" Height="10"
                                             Margin="0,14,0,4" Background="#EDF1F6" Foreground="#1B7A43"/>
                                <TextBlock Text="{Binding ProgressText}" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="#445266" MinHeight="34"/>
                            </StackPanel>
                        </GroupBox>

                        <Border Background="#FFF6E5" BorderBrush="#F0D9A8" BorderThickness="1"
                                CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <TextBlock Text="{Binding StartWarning}" TextWrapping="Wrap" Foreground="#7A5B12" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= الحزم ================= -->
            <TabItem Header="الحزم">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bundles list -->
                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="حزمة جديدة" Command="{Binding BundlesVm.NewBundleCommand}"
                                    Style="{StaticResource NeutralButton}" Margin="0,0,0,6"/>
                            <Button Content="تكرار الحزمة المحددة" Command="{Binding BundlesVm.DuplicateBundleCommand}"
                                    Style="{StaticResource NeutralButton}" Margin="0,0,0,6"/>
                            <Button Content="حذف الحزمة المحددة" Command="{Binding BundlesVm.DeleteBundleCommand}"
                                    Style="{StaticResource WarnButton}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Bundles}" SelectedItem="{Binding SelectedBundle}"
                                 DisplayMemberPath="Name" Background="White" BorderBrush="#D6DEE8"
                                 FontSize="14" Padding="4"/>
                    </DockPanel>

                    <!-- Items editor: root DataContext kept; sub-VM commands prefixed -->
                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="اسم الحزمة:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedBundle.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Padding="6,4" Background="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <Button Content="إضافة صنف" Command="{Binding BundlesVm.AddItemCommand}" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="حذف الصنف المحدد" Command="{Binding BundlesVm.DeleteItemCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                                <Button Content="أعلى ▲" Command="{Binding BundlesVm.MoveItemUpCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                                <Button Content="أسفل ▼" Command="{Binding BundlesVm.MoveItemDownCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="استيراد Excel/CSV…" Command="{Binding BundlesVm.ImportCommand}" Style="{StaticResource NeutralButton}"/>
                                <Button Content="تصدير قالب CSV" Command="{Binding BundlesVm.ExportCsvTemplateCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                                <Button Content="تصدير قالب Excel" Command="{Binding BundlesVm.ExportXlsxTemplateCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding SelectedBundle.Items}"
                                  SelectedItem="{Binding BundlesVm.SelectedItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" Background="White" BorderBrush="#D6DEE8"
                                  RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF1F6" VerticalGridLinesBrush="#EDF1F6"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  EnableRowVirtualization="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الكود / الباركود (اختياري)"
                                                    Binding="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="175"/>
                                <DataGridTextColumn Header="اسم المنتج (مطلوب)"
                                                    Binding="{Binding ProductName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="الكمية"
                                                    Binding="{Binding BaseQuantityText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                    Width="95"/>
                                <DataGridTextColumn Header="السعر المخصص (اختياري)"
                                                    Binding="{Binding CustomPriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                    Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ================= الإعدادات ================= -->
            <TabItem Header="الإعدادات">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">

                        <GroupBox Header="التوقيت">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="التأخير بين الخطوات (مللي ثانية):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding Settings.DelayText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="80" Height="28" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="(من 0 إلى 5000)" Foreground="#7A8699" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="العد التنازلي قبل البدء:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding Settings.CountdownOptions}"
                                              SelectedIndex="{Binding Settings.CountdownIndex}" Width="150" Height="28"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="الاختصارات العامة (تعمل من أي برنامج) — انقر المربع ثم اضغط التركيبة، Backspace للمسح">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="بدء التشغيل:" VerticalAlignment="Center" Margin="0,4"/>
                                <controls:HotkeyCaptureBox Grid.Row="0" Grid.Column="1" Shortcut="{Binding Settings.StartShortcut}" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="إيقاف مؤقت / استئناف:" VerticalAlignment="Center" Margin="0,4"/>
                                <controls:HotkeyCaptureBox Grid.Row="1" Grid.Column="1" Shortcut="{Binding Settings.PauseResumeShortcut}" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="إيقاف نهائي:" VerticalAlignment="Center" Margin="0,4"/>
                                <controls:HotkeyCaptureBox Grid.Row="2" Grid.Column="1" Shortcut="{Binding Settings.StopShortcut}" Margin="0,4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="النسخ الاحتياطي">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تصدير نسخة كاملة…" Command="{Binding Settings.ExportBackupCommand}" Style="{StaticResource NeutralButton}"/>
                                <Button Content="استيراد نسخة…" Command="{Binding Settings.ImportBackupCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="مساعدة سريعة">
                            <TextBlock Text="{Binding Settings.HelpText}" TextWrapping="Wrap" FontSize="12.5" Foreground="#445266"/>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
