<Window x:Class="SahelBundleKeyboard.App.Views.FloatingControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="وحدة التحكم"
        Width="300" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">
    <Border Background="#1E2733" CornerRadius="10" BorderBrush="#3A4A5C" BorderThickness="1" Padding="12">
        <StackPanel Focusable="False">

            <!-- Drag handle + hide button -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="DragArea" Grid.Column="0" Background="#26313F" CornerRadius="6" Padding="8,5"
                        MouseLeftButtonDown="OnDragMoveRequested" Focusable="False">
                    <TextBlock Text="وحدة التحكم العائمة" Foreground="#9FB2C6" FontSize="11.5"/>
                </Border>
                <Button Grid.Column="1" Content="✕ إخفاء" Click="OnHideClick" Focusable="False"
                        Background="#26313F" Foreground="#C7D3E0" BorderThickness="0"
                        FontSize="11.5" Margin="6,0,0,0" Cursor="Hand" ToolTip="إخفاء وحدة التحكم (يمكن إظهارها من تبويب التشغيل)"/>
            </Grid>

            <!-- Bundle selection -->
            <ComboBox x:Name="BundleBox" ItemsSource="{Binding Bundles}"
                      SelectedItem="{Binding SelectedBundle}"
                      DisplayMemberPath="Name"
                      Margin="0,8,0,0" Height="30" FontSize="12.5"
                      ToolTip="اختر الحزمة"/>

            <!-- Count with +/- -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="عدد الحزم:" Foreground="#C7D3E0" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5"/>
                <TextBox x:Name="CountBox" Grid.Column="1"
                         Text="{Binding BundleCountText, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="14"/>
                <Button x:Name="PlusButton" Grid.Column="2" Content="＋" Width="34" Height="28" Margin="6,0,0,0"
                        Background="#26313F" Foreground="#43C98A" BorderThickness="0" FontSize="15" FontWeight="Bold"
                        Cursor="Hand" Click="OnPlusClick" Focusable="False" ToolTip="زيادة عدد الحزم"/>
                <Button x:Name="MinusButton" Grid.Column="3" Content="－" Width="34" Height="28" Margin="4,0,0,0"
                        Background="#26313F" Foreground="#EF7A76" BorderThickness="0" FontSize="15" FontWeight="Bold"
                        Cursor="Hand" Click="OnMinusClick" Focusable="False" ToolTip="إنقاص عدد الحزم"/>
            </Grid>

            <!-- Countdown / progress -->
            <TextBlock x:Name="CountdownText" Text="" Foreground="#F2B33D" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ControllerProgress" Height="8" Minimum="0" Maximum="1"
                             Background="#141B24" Foreground="#37B26C" BorderThickness="0"/>
                <TextBlock Grid.Column="1" x:Name="ProgressLabel" Text="— / —" Foreground="#9FB2C6"
                           Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
            </Grid>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="GoButton" Content="ابدأ ▶" Width="78" Height="34"
                        Background="#1B7A43" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="OnGoClick" Focusable="False"/>
                <Button x:Name="PauseButton" Content="إيقاف مؤقت" Width="82" Height="34" Margin="6,0,0,0"
                        Background="#3A4A5C" Foreground="White" BorderThickness="0" FontSize="12"
                        Cursor="Hand" Click="OnPauseResumeClick" Focusable="False"/>
                <Button Content="⏹ إنهاء" Width="66" Height="34" Margin="6,0,0,0"
                        Background="#B03A2E" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="OnStopClick" Focusable="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
