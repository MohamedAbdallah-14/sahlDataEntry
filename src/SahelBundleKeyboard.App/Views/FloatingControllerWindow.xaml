<Window x:Class="SahelBundleKeyboard.App.Views.FloatingControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="وحدة التحكم"
        Width="280" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">
    <Border Background="#1E2733" CornerRadius="10" BorderBrush="#3A4A5C" BorderThickness="1" Padding="12">
        <StackPanel Focusable="False">
            <!-- Drag handle + title -->
            <Border x:Name="DragArea" Background="#26313F" CornerRadius="6" Padding="8,5"
                    MouseLeftButtonDown="OnDragMoveRequested" Focusable="False">
                <TextBlock x:Name="TitleText" Text="لا توجد حزمة" Foreground="#E7EEF5" FontSize="12.5"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <TextBlock x:Name="CountdownText" Text="" Foreground="#F2B33D" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ControllerProgress" Height="8" Minimum="0" Maximum="1"
                             Background="#141B24" Foreground="#37B26C" BorderThickness="0"/>
                <TextBlock Grid.Column="1" x:Name="ProgressLabel" Text="— / —" Foreground="#9FB2C6"
                           Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="GoButton" Content="ابدأ ▶" Width="82" Height="34"
                        Background="#1B7A43" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="OnGoClick" Focusable="False"/>
                <Button x:Name="PauseButton" Content="إيقاف مؤقت" Width="86" Height="34" Margin="6,0,0,0"
                        Background="#3A4A5C" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="OnPauseResumeClick" Focusable="False"/>
                <Button Content="⏹ إنهاء" Width="70" Height="34" Margin="6,0,0,0"
                        Background="#B03A2E" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="OnStopClick" Focusable="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
