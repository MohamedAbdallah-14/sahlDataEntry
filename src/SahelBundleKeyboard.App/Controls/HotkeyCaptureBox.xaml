<UserControl x:Class="SahelBundleKeyboard.App.Controls.HotkeyCaptureBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Box"
                 Text="{Binding Shortcut, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 Focusable="True"
                 FontSize="13"
                 Padding="8,6"
                 Background="#FFFFFF"
                 ToolTip="انقر هنا ثم اضغط تركيبة المفاتيح المطلوبة (Backspace للمسح)" />
    </Grid>
</UserControl>
